async def do_evaluate(event: Message | CallbackQuery, state: FSMContext):

    data = await state.get_data()

    history = data.get("history", [])

    if not history:

        text = "Сначала начни спор."

        if isinstance(event, CallbackQuery):

            await event.answer(text, show_alert=True)

        else:

            await event.answer(text)

        return



    user_msgs = [m["content"] for m in history if m["role"] == "user"]

    prompt = (

        "Ты эксперт по спорам и риторике. Оцени аргументы пользователя по шкале от 1 до 10 "

        "по критериям: логика, убедительность, эмоциональный контроль, сила позиции. "

        "Дай короткий разбор + что можно улучшить. Пиши по-русски, конкретно и честно."

    )

    eval_messages = [{"role": "user", "content": "Вот мои реплики:\n\n" + "\n\n".join(user_msgs)}]

    result = await ask_ai(eval_messages, prompt)



    text = f"📊 Оценка твоих аргументов:\n\n{result}"

    if isinstance(event, CallbackQuery):

        await event.message.answer(text)

        await event.answer()

    else:

        await event.answer(text)





