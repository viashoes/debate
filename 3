async def init_db():

    async with aiosqlite.connect(DB_PATH) as db:

        await db.execute("""

            CREATE TABLE IF NOT EXISTS users (

                user_id INTEGER PRIMARY KEY,

                username TEXT,

                full_name TEXT,

                join_date TEXT,

                trial_until TEXT,

                sub_until TEXT,

                total_paid INTEGER DEFAULT 0,

                is_blocked INTEGER DEFAULT 0

            )

        """)

        await db.execute("""

            CREATE TABLE IF NOT EXISTS payments (

                id INTEGER PRIMARY KEY AUTOINCREMENT,

                user_id INTEGER,

                amount INTEGER,

                charge_id TEXT,

                date TEXT

            )

        """)

        await db.commit()





async def get_user(user_id: int):

    async with aiosqlite.connect(DB_PATH) as db:

        async with db.execute("SELECT * FROM users WHERE user_id = ?", (user_id,)) as cursor:

            row = await cursor.fetchone()

            if row:

                return {

                    "user_id": row[0],

                    "username": row[1],

                    "full_name": row[2],

                    "join_date": row[3],

                    "trial_until": row[4],

                    "sub_until": row[5],

                    "total_paid": row[6],

                    "is_blocked": row[7]

                }

    return None





async def create_user(user: types.User):

    now = datetime.utcnow()

    trial_until = (now + timedelta(days=TRIAL_DAYS)).isoformat()

    async with aiosqlite.connect(DB_PATH) as db:

        await db.execute(

            "INSERT OR IGNORE INTO users (user_id, username, full_name, join_date, trial_until) VALUES (?, ?, ?, ?, ?)",

            (user.id, user.username, user.full_name, now.isoformat(), trial_until)

        )

        await db.commit()





async def update_sub(user_id: int, days: int = 30, amount: int = 0, charge_id: str = ""):

    user = await get_user(user_id)

    now = datetime.utcnow()

    current_until = datetime.fromisoformat(user["sub_until"]) if user and user["sub_until"] else now

    if current_until < now:

        current_until = now

    new_until = (current_until + timedelta(days=days)).isoformat()



    async with aiosqlite.connect(DB_PATH) as db:

        await db.execute(

            "UPDATE users SET sub_until = ?, total_paid = total_paid + ? WHERE user_id = ?",

            (new_until, amount, user_id)

        )

        if amount > 0:

            await db.execute(

                "INSERT INTO payments (user_id, amount, charge_id, date) VALUES (?, ?, ?, ?)",

                (user_id, amount, charge_id, now.isoformat())

            )

        await db.commit()





async def has_access(user_id: int) -> bool:

    if user_id == ADMIN_ID:

        return True

    user = await get_user(user_id)

    if not user:

        return False

    now = datetime.utcnow()

    if user["trial_until"] and datetime.fromisoformat(user["trial_until"]) > now:

        return True

    if user["sub_until"] and datetime.fromisoformat(user["sub_until"]) > now:

        return True

    return False





async def get_stats():

    async with aiosqlite.connect(DB_PATH) as db:

        async with db.execute("SELECT COUNT(*) FROM users") as c:

            total_users = (await c.fetchone())[0]

        async with db.execute(

            "SELECT COUNT(*) FROM users WHERE sub_until > ?",

            (datetime.utcnow().isoformat(),)

        ) as c:

            active_subs = (await c.fetchone())[0]

        async with db.execute("SELECT SUM(total_paid) FROM users") as c:

            total_earned = (await c.fetchone())[0] or 0

        async with db.execute("SELECT COUNT(*) FROM payments") as c:

            total_payments = (await c.fetchone())[0]

    return total_users, active_subs, total_earned, total_payments





async def ask_ai(messages: list, system: str) -> str:

    headers = {

        "Authorization": f"Bearer {OPENROUTER_API_KEY}",

        "Content-Type": "application/json",

        "HTTP-Referer": "https://t.me",

        "X-Title": "Debate Trainer"

    }

    payload = {

        "model": "meta-llama/llama-3.1-8b-instruct:free",

        "messages": [{"role": "system", "content": system}] + messages,

        "temperature": 0.85,

        "max_tokens": 550

    }

    try:

        async with aiohttp.ClientSession() as session:

            async with session.post(

                "https://openrouter.ai/api/v1/chat/completions",

                json=payload,

                headers=headers,

                timeout=35

            ) as resp:

                data = await resp.json()

                if "choices" in data and data["choices"]:

                    return data["choices"][0]["message"]["content"].strip()

                logging.error(f"OpenRouter response: {data}")

                return "Сейчас не могу ответить. Попробуй чуть позже."

    except Exception as e:

        logging.error(f"AI error: {e}")

        return "Ошибка соединения с ИИ. Попробуй ещё раз."





