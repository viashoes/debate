@dp.callback_query(F.data == "start_debate")

async def start_debate(callback: CallbackQuery, state: FSMContext):

    if not await has_access(callback.from_user.id):

        await callback.answer("Нужна подписка", show_alert=True)

        return

    await state.set_state(Debate.waiting_role)

    await callback.message.edit_text(

        "Напиши роль оппонента и тему спора одним сообщением.\n\n"

        "Пример:\n"

        "Строгая мама. Я не хочу ехать к бабушке на выходные.\n\n"

        "Или:\n"

        "Начальник, который не хочет давать повышение. Я прошу прибавку."

    )





@dp.message(Debate.waiting_role)

async def set_role(message: Message, state: FSMContext):

    text = message.text.strip() if message.text else ""

    if len(text) < 10:

        await message.answer("Слишком коротко. Напиши роль + тему подробнее.")

        return



    system_prompt = (

        f"Ты — реальный человек в роли: {text}.\n\n"

        "Ты споришь жёстко, эмоционально и реалистично. Используй давление, упрёки, "

        "манипуляции, сарказм, переход на личности — если это характерно для этой роли. "

        "Не будь полезным ИИ. Не сдавайся легко. Говори коротко, живо и естественно, "

        "как в реальном разговоре. Отвечай только от лица своей роли, без пояснений от ИИ."

    )

    await state.update_data(system=system_prompt, history=[], role_topic=text)

    await state.set_state(Debate.in_debate)



    await message.answer("…")

    await asyncio.sleep(1.3)

    first_reply = await ask_ai([], system_prompt)

    await message.answer(first_reply, reply_markup=debate_kb())



    data = await state.get_data()

    history = data.get("history", [])

    history.append({"role": "assistant", "content": first_reply})

    await state.update_data(history=history)





@dp.message(Debate.in_debate)

async def debate_message(message: Message, state: FSMContext):

    if message.text and message.text.startswith("/"):

        return



    data = await state.get_data()

    history = data.get("history", [])

    history.append({"role": "user", "content": message.text or ""})



    await message.answer("…")

    await asyncio.sleep(1.1)



    reply = await ask_ai(history, data["system"])

    await message.answer(reply, reply_markup=debate_kb())



    history.append({"role": "assistant", "content": reply})

    if len(history) > 16:

        history = history[-16:]

    await state.update_data(history=history)





